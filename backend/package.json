{
  "name": "dhyan-backend",
  "version": "1.0.0",
  "description": "Dhyan Smart Watchlist Backend Monolith",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "render-build": "npx prisma generate && npx prisma db push && ts-node --transpile-only src/seed.ts && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:db-push": "prisma db push",
    "seed": "ts-node --transpile-only src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.10.0",
    "socket.io": "^4.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  },
  "prisma": {
    "seed": "ts-node --transpile-only src/seed.ts"
  }
}
